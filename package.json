{
  "name": "hacofood",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/db.integration.test.ts tests/loop.integration.test.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "seed:dev": "tsx --env-file=.env.local scripts/seed-dev.mts",
    "test:db": "node scripts/reset-test-db.mjs && TEST_DATABASE_URL=postgres://haco:haco@127.0.0.1:54329/${TEST_DB_NAME:-haco_test} DB_SSL=off tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "jose": "^5.6.3",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.9.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pdfkit": "^0.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
